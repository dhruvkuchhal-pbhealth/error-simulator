# Error Simulator - Environment
# Copy to .env and adjust as needed

# Server
SERVER_PORT=8080

# Kafka (optional)
KAFKA_BOOTSTRAP_SERVERS=10.0.10.135:9092
KAFKA_TOPIC=app-error-logs

# PostgreSQL - same user db as face-recognition-service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/face_recognition

# GitHub / ELK (optional)
GITHUB_REPOSITORY=error-simulator
LATENCY_MS=3000
